---
import SectionHeader from './SectionHeader.astro';
import { experience, featuredBuild, bounties } from '../data/experience';
---

<section id="experience" class="section border-t border-line">
  <SectionHeader index="03" label="experience" title="Where I've been breaking things" />

  <ol class="mt-12 space-y-10 border-l border-line pl-6 sm:pl-8">
    {
      experience.map((r) => (
        <li class="relative">
          <span
            class:list={[
              'absolute top-1.5 -left-[29px] h-2.5 w-2.5 rounded-full ring-4 ring-bg sm:-left-[37px]',
              r.current ? 'bg-accent' : 'bg-line',
            ]}
          />
          <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
            <h3 class="text-lg font-semibold text-ink">
              {r.role} <span class="text-muted">· {r.org}</span>
            </h3>
            <p class="shrink-0 font-mono text-xs text-dim">{r.period}</p>
          </div>
          <ul class="mt-3 space-y-2">
            {r.points.map((p) => (
              <li class="flex gap-3 text-sm leading-relaxed text-muted">
                <span class="mt-0.5 font-mono text-accent-dim">—</span>
                <span>{p}</span>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>

  <!-- Featured build -->
  <article class="card mt-16 border-accent-dim/70 p-6 sm:p-8">
    <p class="eyebrow">Featured build</p>
    <div class="mt-3 flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
      <h3 class="text-2xl font-semibold text-ink">{featuredBuild.title}</h3>
      <p class="font-mono text-xs text-dim">{featuredBuild.context}</p>
    </div>
    <p class="mt-4 max-w-3xl leading-relaxed text-muted">{featuredBuild.problem}</p>

    <ol class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-6">
      {
        featuredBuild.steps.map((s, i) => (
          <li class="relative rounded-lg border border-line bg-surface-2 p-4">
            <p class="font-mono text-[11px] text-accent">{String(i + 1).padStart(2, '0')}</p>
            <p class="mt-1 font-mono text-sm font-semibold text-ink">{s.label}</p>
            <p class="mt-2 text-xs leading-relaxed text-muted">{s.detail}</p>
            {i < featuredBuild.steps.length - 1 && (
              <span class="absolute top-1/2 -right-2.5 z-10 hidden -translate-y-1/2 font-mono text-accent lg:block" aria-hidden="true">
                →
              </span>
            )}
          </li>
        ))
      }
    </ol>
    <p class="mt-6 flex gap-3 text-sm leading-relaxed text-ink/90">
      <span class="font-mono text-accent">=&gt;</span>
      <span>{featuredBuild.outcome}</span>
    </p>
  </article>

  <!-- Bug bounty -->
  <div class="mt-16">
    <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
      <h3 class="text-xl font-semibold text-ink">Selected bug bounty findings</h3>
      <p class="font-mono text-xs text-dim">private programmes · disclosed at vulnerability-class level</p>
    </div>
    <div class="mt-6 grid gap-5 md:grid-cols-3">
      {
        bounties.map((b) => (
          <article class="card">
            <span class="chip border-accent-dim text-accent">{b.impact}</span>
            <h4 class="mt-4 font-semibold text-ink">{b.title}</h4>
            <p class="mt-2 text-sm leading-relaxed text-muted">{b.detail}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
