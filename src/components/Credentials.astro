---
import SectionHeader from './SectionHeader.astro';
import { certifications, arsenal, education } from '../data/credentials';
import { profile } from '../data/profile';

const issuers = [...new Set(certifications.map((c) => c.issuer))];
---

<section id="credentials" class="section border-t border-line">
  <SectionHeader index="05" label="credentials" title="Certifications & arsenal" />

  <div class="mt-10 flex flex-wrap gap-2" role="group" aria-label="Filter certifications by issuer">
    <button type="button" class="chip filter-btn cursor-pointer" data-filter="all" aria-pressed="true">All</button>
    {
      issuers.map((i) => (
        <button type="button" class="chip filter-btn cursor-pointer" data-filter={i} aria-pressed="false">
          {i}
        </button>
      ))
    }
  </div>

  <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      certifications.map((c) => (
        <article
          class:list={['card cert flex flex-col', c.progress !== undefined && 'border-warn/40']}
          data-category={c.issuer}
        >
          <div class="flex items-start justify-between gap-3">
            <p class="font-mono text-lg font-semibold text-ink">{c.short}</p>
            {c.progress === undefined ? (
              <span class="chip border-accent-dim text-accent">Certified</span>
            ) : (
              <span class="chip border-warn/50 text-warn">In progress</span>
            )}
          </div>
          <p class="mt-2 text-sm text-muted">{c.name}</p>
          <p class="mt-1 font-mono text-xs text-dim">
            {c.issuer}
            {c.issued && <span> · {c.issued}</span>}
          </p>
          {c.credentialId && (
            <p class="mt-3 flex items-center gap-2 font-mono text-xs text-muted">
              <span>ID</span>
              <code class="rounded bg-surface-2 px-1.5 py-0.5 text-ink">{c.credentialId}</code>
              <button
                type="button"
                class="copy-id cursor-pointer text-dim hover:text-accent"
                data-id={c.credentialId}
                aria-label={`Copy ${c.short} credential ID`}
              >
                copy
              </button>
            </p>
          )}
          {c.progress !== undefined && (
            <div class="mt-4">
              <div class="flex justify-between font-mono text-[11px] text-muted">
                <span>Course progress</span>
                <span class="text-warn">{c.progress}%</span>
              </div>
              <div
                class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-surface-2"
                role="progressbar"
                aria-valuenow={c.progress}
                aria-valuemin="0"
                aria-valuemax="100"
                aria-label={`${c.short} course progress`}
              >
                <div class="h-full rounded-full bg-warn" style={`width: ${c.progress}%`} />
              </div>
            </div>
          )}
          {c.verifyUrl && (
            <a
              href={c.verifyUrl}
              target="_blank"
              rel="noopener"
              class="mt-auto self-start pt-4 font-mono text-xs text-accent hover:underline"
              aria-label={`Verify ${c.short} credential`}
            >
              ✓ Verify credential ↗
            </a>
          )}
        </article>
      ))
    }
  </div>
  <p id="secops-note" class="mt-4 font-mono text-xs text-dim">
    SecOps Group certificates: copy the ID and enter it with the name "{profile.name}" on the validation page.
  </p>

  <div class="mt-16 grid gap-10 lg:grid-cols-[1.6fr_1fr]">
    <div>
      <h3 class="font-mono text-sm text-accent">// arsenal</h3>
      <dl class="mt-5 space-y-6">
        {
          arsenal.map((g) => (
            <div>
              <dt class="text-sm font-semibold text-ink">{g.group}</dt>
              <dd class="mt-2 flex flex-wrap gap-1.5">
                {g.items.map((i) => (
                  <span class="chip">{i}</span>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div>
      <h3 class="font-mono text-sm text-accent">// education</h3>
      <div class="card mt-5">
        <p class="font-semibold text-ink">{education.school}</p>
        <p class="mt-1 text-sm text-muted">{education.degree}</p>
        <div class="mt-4 flex justify-between font-mono text-xs text-dim">
          <span>{education.period}</span>
          <span>GPA {education.gpa}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('#credentials .filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('#credentials .cert');
  const note = document.getElementById('secops-note');
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      cards.forEach((c) => {
        c.hidden = filter !== 'all' && c.dataset.category !== filter;
      });
      // The manual-validation hint only applies to SecOps Group certificates.
      if (note) note.hidden = filter !== 'all' && filter !== 'The SecOps Group';
    }),
  );

  document.querySelectorAll<HTMLButtonElement>('.copy-id').forEach((btn) =>
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.id ?? '');
        btn.textContent = 'copied';
      } catch {
        btn.textContent = 'copy failed';
      }
      setTimeout(() => (btn.textContent = 'copy'), 1500);
    }),
  );
</script>
