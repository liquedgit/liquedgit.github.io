---
import { profile, stats } from '../data/profile';
---

<section id="top" class="relative overflow-hidden pt-16">
  <div class="grid-bg pointer-events-none absolute inset-0"></div>
  <div class="relative mx-auto max-w-6xl px-4 pt-20 pb-16 sm:px-6 md:pt-32 md:pb-24">
    <p class="font-mono text-sm text-muted">
      <span class="text-accent">$</span> whoami
    </p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight text-ink sm:text-6xl">
      {profile.name}
    </h1>
    <p class="caret mt-4 font-mono text-lg text-accent sm:text-2xl">{profile.title}</p>
    <p class="mt-5 flex flex-wrap gap-x-3 gap-y-1 font-mono text-xs text-muted sm:text-sm">
      {
        profile.focus.map((f, i) => (
          <>
            {i > 0 && <span class="text-dim">·</span>}
            <span>{f}</span>
          </>
        ))
      }
    </p>
    <p class="mt-8 max-w-2xl text-lg leading-relaxed text-ink/90 sm:text-xl">{profile.tagline}</p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href="#contact" class="btn-primary">Get in touch</a>
      <a href={profile.links.github} class="btn-ghost" target="_blank" rel="noopener">GitHub ↗</a>
      <a href={profile.links.linkedin} class="btn-ghost" target="_blank" rel="noopener">LinkedIn ↗</a>
      <a href={profile.links.hackthebox} class="btn-ghost" target="_blank" rel="noopener">Hack The Box ↗</a>
    </div>
    <p class="mt-8 font-mono text-xs text-dim">📍 {profile.location} · open to international relocation</p>
  </div>

  <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
    <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-line bg-line md:grid-cols-4">
      {
        stats.map((s) => (
          <div class="bg-surface p-5 sm:p-6">
            <dt class="font-mono text-2xl font-semibold text-accent sm:text-3xl">{s.value}</dt>
            <dd class="mt-1 text-xs text-muted sm:text-sm">{s.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
